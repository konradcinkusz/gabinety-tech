@* The header of DESIGN-CONTRACT 5.1: brand, main navigation, the account area by session. Under 40 rem the navigation and the account area become ONE native <details> menu (no JavaScript, 44 px target);
   both renderings are in the page and CSS shows one, so the links are never reachable twice at the same width. The session is read once, from the authentication state (never HttpContext). *@
@inject NavigationManager Navigation

<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="/">@Pl.Site.Name</a>
        <nav class="site-nav" aria-label="@Pl.Nav.Label">
            <ul class="nav-list">
                @foreach (var item in Model.Links)
                {
                    <li><a href="@item.Href" aria-current="@Current(item)">@item.Label</a></li>
                }
            </ul>
        </nav>
        <div class="site-account">
            @if (Model.SignedIn)
            {
                <details class="account-menu">
                    <summary aria-label="@Pl.Nav.AccountMenuLabel" data-testid="account-menu">@Pl.Nav.AccountMenu</summary>
                    <ul>
                        @foreach (var item in Model.AccountMenu)
                        {
                            <li><a href="@item.Href" aria-current="@Current(item)">@item.Label</a></li>
                        }
                    </ul>
                </details>
            }
            else
            {
                <a class="btn btn--ghost" href="@ReturnTarget.LoginUrl(Back)">@Model.SignIn!.Label</a>
                <a class="btn btn--primary" href="@ReturnTarget.RegisterUrl(Back)">@Model.Register!.Label</a>
            }
        </div>
        <details class="site-menu">
            <summary>@Pl.Nav.Menu</summary>
            <nav aria-label="@Pl.Nav.Label">
                <ul>
                    @foreach (var item in Model.Flat)
                    {
                        <li><a href="@item.Href" aria-current="@Current(item)">@item.Label</a></li>
                    }
                </ul>
            </nav>
        </details>
    </div>
</header>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    HeaderModel Model { get; set; } = SiteNavigation.For(null, "/");

    string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    /// <summary>The page a visitor came from becomes the return target of sign-in, except on the sign-in pages themselves (a loop; <see cref="ReturnTarget.Safe"/> turns those into "/").</summary>
    string Back => ReturnTarget.Safe(Path == "/" ? null : "/" + Navigation.ToBaseRelativePath(Navigation.Uri));

    string? Current(NavItem item) => item.IsCurrent(Path) ? "page" : null;

    protected override async Task OnParametersSetAsync() =>
        Model = SiteNavigation.For(AuthState is null ? null : (await AuthState).User, Path);
}
