@page "/gabinet-programisty/profil"
@attribute [Authorize]
@layout PractitionerLayout
@inherits PractitionerPage
@* One plain form: the posted fields are read, saved through the service, and a success redirects with the flash "Zapisano." (a refresh does not post again). Errors are shown all at once, in a summary and under each field (contract 5.5). *@
<PageTitle>@PlPractitioner.Profile.MetaTitle</PageTitle>
<h1>@PlPractitioner.Profile.Title</h1>

@if (LoadFailure is not null)
{
    <Alert Variant="AlertVariant.Danger" TestId="unavailable">@FailureText(LoadFailure) <a href="@PractitionerPaths.Profile">@PlPractitioner.Common.Retry</a></Alert>
}
else if (Profile is not null)
{
    <ErrorSummary Errors="Summary" />
    @if (_general is not null) {<Alert Variant="AlertVariant.Danger" TestId="profile-error">@_general</Alert>}
    <div class="grid-2">
        <form method="post" @onsubmit="SaveAsync" @formname="profile" class="form stack form-narrow" novalidate>
            <AntiforgeryToken />
            <FormField Id="displayName" Label="@PlPractitioner.Profile.DisplayName" Error="@Error("displayName")" Max="80" Length="_v.DisplayName.Length">
                <input id="@context.Id" name="displayName" value="@_v.DisplayName" maxlength="80" autocomplete="name" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
            </FormField>
            <FormField Id="headline" Label="@PlPractitioner.Profile.Headline" Hint="@PlPractitioner.Profile.HeadlineHint" Error="@Error("headline")" Max="120" Length="_v.Headline.Length">
                <input id="@context.Id" name="headline" value="@_v.Headline" maxlength="120" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
            </FormField>
            <FormField Id="bio" Label="@PlPractitioner.Profile.Bio" Hint="@PlPractitioner.Profile.BioHint" Error="@Error("bio")" Max="2000" Length="_v.Bio.Length">
                <textarea id="@context.Id" name="bio" rows="8" maxlength="2000" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)">@_v.Bio</textarea>
            </FormField>
            <FormField Id="portfolioUrl" Label="@PlPractitioner.Profile.Portfolio" Hint="@PlPractitioner.Profile.PortfolioHint" Error="@Error("portfolioUrl")" Optional="true">
                <input id="@context.Id" name="portfolioUrl" type="url" inputmode="url" value="@_v.PortfolioUrl" maxlength="300" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
            </FormField>
            <FormField Id="meetingUrlDefault" Label="@PlPractitioner.Profile.Meeting" Hint="@PlPractitioner.Profile.MeetingHint" Error="@Error("meetingUrlDefault")" Optional="true">
                <input id="@context.Id" name="meetingUrlDefault" type="url" inputmode="url" value="@_v.MeetingUrl" maxlength="300" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
            </FormField>
            <FormField Id="nip" Label="@PlPractitioner.Profile.Nip" Hint="@(Profile.Status == "Approved" ? PlPractitioner.Profile.NipChangeWarning : PlPractitioner.Profile.NipHint)" Error="@Error("nip")" Optional="true">
                <input id="@context.Id" name="nip" inputmode="numeric" value="@_v.Nip" maxlength="10" autocomplete="off" aria-describedby="@context.DescribedBy" aria-invalid="@Invalid(context)" />
            </FormField>
            <div class="form-actions"><button class="btn btn--primary" type="submit">@PlPractitioner.Common.Save</button></div>
        </form>
        <section class="card profile-preview" aria-labelledby="profile-preview-title">
            <p class="muted" id="profile-preview-title">@PlPractitioner.Profile.PreviewTitle</p>
            <p class="profile-preview__name">@Profile.DisplayName</p>
            @if (!string.IsNullOrEmpty(Profile.Headline)) {<p class="profile-preview__headline">@Profile.Headline</p>}
            @if (!string.IsNullOrEmpty(Profile.Bio)) {<p class="profile-preview__bio">@Profile.Bio</p>}
        </section>
    </div>
}

@code {
    sealed record Values(string DisplayName, string Headline, string Bio, string PortfolioUrl, string MeetingUrl, string Nip);

    Values _v = new("", "", "", "", "", "");
    string? _general;
    readonly Dictionary<string, string> _errors = [];

    string? Error(string field) => _errors.GetValueOrDefault(field);
    static string? Invalid(FormField.FieldContext c) => c.Invalid ? "true" : null;

    /// <summary>The errors in the order of the form, each pointing at its field's id.</summary>
    IReadOnlyList<KeyValuePair<string, string>> Summary => [.. new[] { "displayName", "headline", "bio", "portfolioUrl", "meetingUrlDefault", "nip" }.Where(_errors.ContainsKey).Select(f => KeyValuePair.Create(f, _errors[f]))];

    protected override async Task OnInitializedAsync()
    {
        if (!await LoadProfileAsync()) return;
        var p = Profile!;
        _v = new(p.DisplayName, p.Headline, p.Bio, p.PortfolioUrl ?? "", p.MeetingUrlDefault ?? "", p.Nip ?? "");
    }

    async Task SaveAsync()
    {
        var f = Posted;
        _v = new(f.Text("displayName"), f.Text("headline"), f.Text("bio"), f.Text("portfolioUrl"), f.Text("meetingUrlDefault"), f.Text("nip"));
        static string? Blank(string s) => s.Length == 0 ? null : s; // an empty optional field is omitted, not sent as null (CONTRACTS 0)
        var r = await Practitioner.SaveProfileAsync(new UpdatePractitionerBody(_v.DisplayName, _v.Headline, _v.Bio, Blank(_v.PortfolioUrl), Blank(_v.MeetingUrl), Blank(_v.Nip)));
        if (r.IsOk) { Done(PractitionerPaths.Profile, FlashKey.Saved); return; }
        foreach (var (field, message) in FieldErrors.From(r.Failure!, new Dictionary<string, string?> { ["headline"] = _v.Headline, ["bio"] = _v.Bio })) _errors[field] = message;
        if (_errors.Count == 0) _general = FieldErrors.General(r.Failure!, PlPractitioner.Common.Unavailable);
    }
}
