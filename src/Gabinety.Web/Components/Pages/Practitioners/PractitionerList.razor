@page "/programisci"
@page "/programisci/{Problem}"
@page "/programisci/{Problem}/{Tech}"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.OutputCaching.OutputCache(PolicyName = Gabinety.Web.Hosting.PublicPageCachePolicy.Name)]
@inject DirectoryClient Directory
@inject NavigationManager Navigation
@inject Gabinety.Web.Hosting.WebOptions Site
@inject TimeProvider Clock
@* Static server rendering with the state in the URL (route values and query): the list, the filters and the pagination are plain links and a GET form, so the page is complete HTML. *@

@if (_view is { } view)
{
    <PageTitle>@view.MetaTitle</PageTitle>
    <HeadContent>
        <meta name="description" content="@view.MetaDescription" />
        <link rel="canonical" href="@(Site.SiteBaseUrl + view.CanonicalPath)" />
        <meta name="robots" content="@view.Robots" />
        <meta property="og:title" content="@view.MetaTitle" />
        <meta property="og:description" content="@view.MetaDescription" />
        <meta property="og:url" content="@(Site.SiteBaseUrl + view.CanonicalPath)" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="pl_PL" />
    </HeadContent>
    @if (view.Breadcrumb() is { Count: > 0 } crumbs)
    {
        <nav aria-label="@PlPages.Nav.Breadcrumb" class="breadcrumb">
            <ol class="cluster">
                @foreach (var (label, href) in crumbs)
                {
                    <li>@if (href is not null) {<a href="@href">@label</a>} else {<span aria-current="page">@label</span>}</li>
                }
            </ol>
        </nav>
    }
    <header class="page-header">
        <h1>@view.Heading</h1>
        <p class="lead">@view.Intro</p>
        @if (view.ResultCount(_page?.Items.Count ?? 0, _page?.NextCursor is not null) is { } count)
        {
            <p class="result-summary cluster">
                <span class="result-summary__total">@ListFormat.PractitionerCount(count)</span>
                <span class="muted" data-testid="count">@string.Format(Pl.ListPage.Count, count)</span>
            </p>
        }
        @* The order of the list (T-11.05). A GET form: the filters ride along as hidden fields and the cursor is dropped, because a cursor belongs to the order it was made for.
           The select applies on change where scripts run (data-enhance="autosubmit"); the button is for a page without script. The default is not written to the URL. *@
        <form method="get" action="@view.State.Path" class="sort-form" data-testid="sort">
            @if (view.State.Duration is { } duration) {<input type="hidden" name="duration" value="@duration" />}
            @if (view.State.MaxPriceMinor is { } price) {<input type="hidden" name="maxPriceMinor" value="@price" />}
            @if (!string.IsNullOrEmpty(view.State.Q)) {<input type="hidden" name="q" value="@view.State.Q" />}
            @if (view.State.Contract) {<input type="hidden" name="contract" value="1" />}
            <label for="sortuj" class="sort-form__label">@Pl.ListPage.SortLabel</label>
            <select id="sortuj" name="sortuj" class="sort-form__select" data-enhance="autosubmit">
                @foreach (var option in view.SortOptions())
                {
                    <option value="@option.Value" selected="@option.Selected">@option.Label</option>
                }
            </select>
            <noscript><button class="btn" type="submit">@Pl.ListPage.SortSubmit</button></noscript>
        </form>
    </header>
    <div class="list-layout">
        <FilterNav State="view.State" Groups="view.Filters()" ActiveCount="view.ActiveFilters" />
        <section aria-label="@Pl.ListPage.ResultsLabel">
            @if (_page is { Items.Count: 0 })
            {
                <div class="empty-state" data-testid="empty">
                    <h2 class="empty-state__title">@Pl.ListPage.EmptyTitle</h2>
                    <p>@Pl.ListPage.EmptyBody</p>
                    @* The active filters are removable chips (each link drops that one filter); the list is not a ul, so an empty list is never rendered. *@
                    @if (view.ActiveChips() is { Count: > 0 } chips)
                    {
                        <div class="cluster" role="group" aria-label="@Pl.ListPage.ActiveFilters">
                            @foreach (var chip in chips)
                            {
                                <a class="chip" href="@chip.Href">@chip.Label <span aria-hidden="true">×</span><span class="visually-hidden"> (@Pl.ListPage.RemoveFilter)</span></a>
                            }
                        </div>
                        <a class="btn btn--ghost" href="@view.State.Cleared().Href()">@Pl.ListPage.ClearFilters</a>
                    }
                </div>
            }
            else if (_page is not null)
            {
                <ul class="results" data-testid="practitioner-list">
                    @foreach (var p in _page.Items)
                    {
                        <li><PractitionerCard Practitioner="p" CategoryNames="view.ProblemNames" TechNames="view.TechNames" Now="_now" /></li>
                    }
                </ul>
            }
            <Pagination PreviousHref="@(view.State.Cursor is null ? null : view.State.FirstPage().Href())"
                        NextHref="@(_page?.NextCursor is { } next ? (view.State with { Cursor = next }).Href() : null)" />
        </section>
    </div>
}
else
{
    <PageTitle>@Pl.ListPage.MetaAllTitle</PageTitle>
    <HeadContent><meta name="robots" content="noindex,follow" /></HeadContent>
    <h1>@Pl.ListPage.AllTitle</h1>
    <Alert Variant="AlertVariant.Danger" TestId="list-error">@Pl.ListPage.Unavailable</Alert>
}

@code {
    [CascadingParameter] HttpContext? Http { get; set; }
    [Parameter] public string? Problem { get; set; }
    [Parameter] public string? Tech { get; set; }
    [SupplyParameterFromQuery(Name = "duration")] public string? DurationParam { get; set; }
    [SupplyParameterFromQuery(Name = "maxPriceMinor")] public string? MaxPriceParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "contract")] public string? ContractParam { get; set; }
    [SupplyParameterFromQuery(Name = "cursor")] public string? CursorParam { get; set; }
    [SupplyParameterFromQuery(Name = "sortuj")] public string? SortParam { get; set; }

    ListView? _view;
    PageDto<PractitionerCardDto>? _page;
    DateTimeOffset _now;

    protected override async Task OnParametersSetAsync()
    {
        var state = ListState.Parse(Problem, Tech, DurationParam, MaxPriceParam, QueryParam, CursorParam, SortParam, ContractParam);
        var query = new PractitionerQuery(state.Problem, state.Tech, state.Q, state.Duration, state.MaxPriceMinor, state.Cursor, state.ApiSort, state.Contract);
        _now = Clock.GetUtcNow();
        // Three independent reads: a failure of any is an error state of this page, never an exception (BLAZOR-WEB-APP section 5).
        var taxonomyTask = Directory.TaxonomyAsync();
        var sitemapTask = Directory.SitemapAsync();
        var pageTask = Directory.PractitionersAsync(query);
        await Task.WhenAll(taxonomyTask, sitemapTask, pageTask);
        var (taxonomy, sitemap, page) = (taxonomyTask.Result, sitemapTask.Result, pageTask.Result);

        if (!taxonomy.IsOk || !sitemap.IsOk) { Unavailable(); return; }
        var view = new ListView(state, taxonomy.Value!, sitemap.Value!);
        if (!view.IsKnown) { Navigation.NotFound(); return; } // an unknown problem or technology is a 404, not an empty list
        if (page.Failure is { Status: 400 or 404 or 422 }) { Navigation.NotFound(); return; } // the Directory refused the cursor: a stale or forged link
        if (!page.IsOk) { Unavailable(); return; }
        (_view, _page) = (view, page.Value);

        void Unavailable()
        {
            (_view, _page) = (null, null);
            // 503 for a crawler: an error page must not be indexed as a 200. Only possible while the response has not started (static rendering).
            if (Http is { Response.HasStarted: false }) Http.Response.StatusCode = StatusCodes.Status503ServiceUnavailable;
        }
    }
}
