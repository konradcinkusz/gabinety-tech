<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- ADR-0010: the Blazor Web App frontend. References the kernel and its Edge project and nothing else (BLAZOR-WEB-APP section 4): DTOs are copies, the contract is HTTP (P3).
       No PackageReference of its own: the ASP.NET Core shared framework only (no component library, no JS packages). -->
  <ItemGroup>
    <ProjectReference Include="../Gabinety.ServiceDefaults/Gabinety.ServiceDefaults.csproj" />
    <ProjectReference Include="../Gabinety.ServiceDefaults.Edge/Gabinety.ServiceDefaults.Edge.csproj" />
    <!-- The owner's legal text, embedded (the one copy since the cutover; a test pins the resource to the file). -->
    <EmbeddedResource Include="Content/Legal/*.md" LogicalName="Gabinety.Web.Content.Legal.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Gabinety.Web.Tests" />
  </ItemGroup>
</Project>
