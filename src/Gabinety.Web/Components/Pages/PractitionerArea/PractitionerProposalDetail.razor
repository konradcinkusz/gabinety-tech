@page "/gabinet-programisty/propozycje/{Id:guid}"
@attribute [Authorize]
@layout PractitionerLayout
@using Gabinety.Web.Components.Pages.Proposals
@inherits ProposalDetailBase
@* The programmer's side of one proposal (ADR proposal 0013). All the behaviour is in ProposalDetailBase; the view is shared with the client's page. *@

<PageTitle>@ProposalsText.Detail.MetaTitle</PageTitle>
<h1>@ProposalsText.Detail.Title</h1>

@if (LoadFailure is not null)
{
    <div class="callout callout--danger" role="alert" data-testid="unavailable">
        <p>@ProposalFormat.FailureText(LoadFailure)</p>
        <a class="btn btn--secondary" href="@DetailHref()">@ProposalsText.Detail.Reload</a>
    </div>
}
else if (Current is { } proposal)
{
    <ProposalDetailView View="proposal" Open="@Open" DoneText="@DoneText" Errors="Errors" ActionFailure="ActionFailure" Counter="CounterFields" CounterText="@CounterText" Today="Today"
                        DetailPath="@PathOf(Id)" ListPath="@ListPath" OnAccept="AcceptAsync" OnReject="RejectAsync" OnWithdraw="WithdrawAsync" OnCounter="CounterAsync" />
}

@code {
    protected override string ViewerRole => ProposalFormat.PractitionerRole;
    protected override string PathOf(Guid id) => $"{PractitionerPaths.Proposals}/{id}";
    protected override string OtherPathOf(Guid id) => $"/moje/propozycje/{id}";
    protected override string ListPath => PractitionerPaths.Proposals;
}
