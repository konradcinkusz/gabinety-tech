@* The slot picker of one offer (P-PROF-1, pattern 5.4): a strip of the days that have free times, then the times of ONE day; every control is a link, so it works without JavaScript and a
   slot leads to /rezerwacja/{offer}?start=...&gabinet=... exactly as the Next.js page does.
   With RescheduleBookingId (the reschedule page) the times are submit buttons named Model.StartUtc, for the form the page wraps the picker in; the days and "more" stay links, to the reschedule page. *@
<div class="slot-picker" aria-live="polite">
    @if (!Slots.Available)
    {
        <Alert Variant="AlertVariant.Warning" TestId="slots-unavailable">@PlPages.Slots.Unavailable</Alert>
        <a class="btn" href="@PickerLink(Windows, SelectedDay)">@PlPages.Slots.Retry</a>
    }
    else if (_selected is null)
    {
        <p class="muted" data-testid="slots-empty">@string.Format(PlPages.Slots.Empty, Windows * SlotPickerModel.WindowDays)</p>
        @MoreLink
    }
    else
    {
        @if (SlotPickerModel.NearestLabel(Slots.Days, Today) is { } nearest)
        {
            <p class="slot-nearest" data-testid="slots-nearest">@string.Format(PlPages.Slots.Nearest, nearest)</p>
        }
        @if (_hasPages)
        {
            <div class="slot-weeks">
                @if (_prevDay is { } pd)
                {
                    <a class="btn btn--ghost" href="@PickerLink(Windows, pd)">@PlPages.Slots.PrevWeek</a>
                }
                @if (_nextDay is { } nd)
                {
                    <a class="btn btn--ghost slot-weeks__next" href="@PickerLink(Windows, nd)">@PlPages.Slots.NextWeek</a>
                }
            </div>
        }
        <div class="slot-strip">
            <ul class="slot-days" aria-label="@PlPages.Slots.PickDay">
                @foreach (var d in _page)
                {
                    <li><a class="chip slot-day" href="@PickerLink(Windows, d.Date)" aria-label="@PlFormat.DayHeading(d.Date)" aria-current="@(d.Date == _selected.Date ? "true" : null)"><span class="slot-day__week" aria-hidden="true">@SlotDayFormat.ShortWeekday(d.Date)</span><span class="slot-day__date" aria-hidden="true">@SlotDayFormat.ShortDate(d.Date)</span></a></li>
                }
            </ul>
        </div>
        <section aria-label="@string.Format(PlPages.Slots.Times, PlFormat.DayHeading(_selected.Date))" class="slot-parts">
            @foreach (var (part, slots) in SlotPickerModel.GroupByPartOfDay(_selected.Slots))
            {
                <div class="slot-part">
                    <h4 class="slot-part__title">@PartTitle(part)</h4>
                    <ul class="slot-times">
                        @foreach (var s in slots)
                        {
                            @if (RescheduleBookingId is null)
                            {
                                <li><a class="chip slot" href="@SlotPickerModel.BookingHref(Offering.Id, s.StartUtc, Slug)" data-utc="@SlotPickerModel.UtcText(s.StartUtc)">@PlFormat.Time(s.StartUtc)</a></li>
                            }
                            else
                            {
                                <li><button type="submit" class="chip slot" name="Model.StartUtc" value="@SlotPickerModel.UtcText(s.StartUtc)" data-utc="@SlotPickerModel.UtcText(s.StartUtc)">@PlFormat.Time(s.StartUtc)</button></li>
                            }
                        }
                    </ul>
                </div>
            }
        </section>
        @MoreLink
        <p class="muted">@PlPages.Slots.TimeZone</p>
        @* Shown by enhance.js only when the visitor's zone differs from Warsaw; the wording is the template here, filled with the zone and one example time. *@
        <p class="muted" data-enhance="local-time-note" data-template="@PlPages.Slots.LocalNote" data-title="@PlPages.Slots.LocalTitle" hidden></p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public OfferingDto Offering { get; set; } = default!;
    [Parameter, EditorRequired] public OfferSlots Slots { get; set; } = default!;
    /// <summary>How many 14-day windows were read (the "more days" link asks for one more).</summary>
    [Parameter] public int Windows { get; set; } = 1;
    [Parameter] public DateOnly? SelectedDay { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    /// <summary>Set by the reschedule page: each time is a submit button of the page's form (the new start) instead of a link to the booking flow.</summary>
    [Parameter] public Guid? RescheduleBookingId { get; set; }

    DayGroup? _selected;
    IReadOnlyList<DayGroup> _page = [];
    DateOnly? _prevDay, _nextDay;
    bool _hasPages;

    protected override void OnParametersSet()
    {
        _selected = SlotPickerModel.Selected(Slots.Days, SelectedDay);
        if (_selected is null) return;
        _page = SlotPickerModel.Page(Slots.Days, _selected.Date, out var index);
        _prevDay = SlotPickerModel.NeighbourPageDay(Slots.Days, index, -1);
        _nextDay = SlotPickerModel.NeighbourPageDay(Slots.Days, index, 1);
        _hasPages = Slots.Days.Count > SlotPickerModel.PageDays;
    }

    static string PartTitle(SlotPickerModel.TimeOfDay part) => part switch
    {
        SlotPickerModel.TimeOfDay.Morning => PlPages.Slots.Morning,
        SlotPickerModel.TimeOfDay.Afternoon => PlPages.Slots.Afternoon,
        _ => PlPages.Slots.Evening,
    };

    /// <summary>The picker's own links: the profile's offer anchor, or the reschedule page in its mode.</summary>
    string PickerLink(int windows, DateOnly? day) => RescheduleBookingId is { } id
        ? SlotPickerModel.ReschedulePickerHref(id, windows, day)
        : SlotPickerModel.PickerHref(Slug, windows, Offering.Id, day);

    RenderFragment MoreLink => @<text>@if (Windows < SlotPickerModel.MaxWindows && SlotPickerModel.Window(Today, Windows) is not null)
    {
        <a class="btn btn--ghost" href="@PickerLink(Windows + 1, _selected?.Date)">@PlPages.Slots.More</a>
    }</text>;
}
