<article class="card card--link practitioner-card" data-testid="practitioner-card">
    <div class="practitioner-card__avatar">
        <Avatar Name="@Practitioner.DisplayName" Size="Avatar.AvatarSize.Medium" />
    </div>
    <div class="practitioner-card__body">
        <h2 class="practitioner-card__name"><a href="@($"/gabinet/{Practitioner.Slug}")">@Practitioner.DisplayName</a></h2>
        <p class="practitioner-card__headline">@Practitioner.Headline</p>
        <p class="cluster practitioner-card__meta">
            @* One verification badge: the four checks are the same on every card and so carry no information; the full list is on the profile (P-LIST-2). *@
            @if (Practitioner.Badges.Contains("approved"))
            {
                <span class="badge badge--success">@PlPages.ListExtra.Verified</span>
            }
            @if (Practitioner.Rating is { } rating && !Practitioner.IsNew)
            {
                <span class="practitioner-card__rating num" role="img" aria-label="@string.Format(Pl.Card.Rating, PlFormat.Rating(rating.Average), rating.Count)">★ @PlFormat.Rating(rating.Average) (@rating.Count)</span>
            }
            else
            {
                <span class="badge badge--neutral">@Pl.Card.IsNew</span>
            }
        </p>
        @if (Categories.Count > 0)
        {
            <p class="practitioner-card__categories">
                @foreach (var category in Categories)
                {
                    <span>@category</span>
                }
            </p>
        }
    </div>
    <p class="practitioner-card__price">
        <span class="practitioner-card__from num">@Pl.Card.From @ListFormat.Price(Practitioner.FromPrice.AmountMinor)</span>
        <span class="practitioner-card__durations muted">@string.Join(", ", Practitioner.Durations.Select(d => string.Format(Pl.Filters.Minutes, d)))</span>
    </p>
</article>

@code {
    /// <summary>The Polish names of the problem categories by slug, from the list page's taxonomy. A slug without a name is not shown.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? CategoryNames { get; set; }

    [Parameter, EditorRequired] public PractitionerCardDto Practitioner { get; set; } = default!;

    /// <summary>At most three problems, in the order the Directory gives them.</summary>
    IReadOnlyList<string> Categories
    {
        get
        {
            if (CategoryNames is not { } names) return [];
            return Practitioner.ProblemSlugs.Where(names.ContainsKey).Take(3).Select(slug => names[slug]).ToList();
        }
    }
}
