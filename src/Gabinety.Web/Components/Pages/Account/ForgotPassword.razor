@page "/zapomniane-haslo"
@attribute [AllowAnonymous]
@using Gabinety.Web.Hosting
@inject IdentityClient Identity
@* Static server rendering: a form post handled by the host, antiforgery protected, works with JavaScript disabled. The answer is IDENTICAL for a known and an unknown address: the same status, the same text, the same markup. *@

<PageTitle>@Pl.Forgot.MetaTitle</PageTitle>
<HeadContent><meta name="robots" content="noindex,follow" /></HeadContent>

<div class="container--form auth-page">
    <div class="card">
        <h1>@Pl.Forgot.Title</h1>

        @if (_sent)
        {
            <Alert Variant="AlertVariant.Success" TestId="forgot-answer">@Pl.Forgot.Answer</Alert>
            @if (_oauthOnly)
            {
                <p class="muted" data-testid="forgot-oauth">@Pl.Forgot.OAuthOnly</p>
            }
        }
        else
        {
            <p class="muted">@Pl.Forgot.Lead</p>
            <FormSummary Problems="_problems" />
            <div role="alert">
                @if (_message is not null)
                {
                    <p class="callout callout--danger" data-testid="forgot-error">@_message</p>
                }
            </div>
            <EditForm Model="Model!" FormName="forgot-password" OnSubmit="SubmitAsync" class="form" novalidate>
                <div class="field @(_problems.For(ForgotPasswordModel.EmailId) is null ? "" : "field--invalid")">
                    <label class="field__label" for="@ForgotPasswordModel.EmailId">@Pl.Forgot.Email</label>
                    <input id="@ForgotPasswordModel.EmailId" name="Model.Email" value="@Model!.Email" class="field__control" type="email" autocomplete="email" inputmode="email" maxlength="254"
                           aria-invalid="@(_problems.For(ForgotPasswordModel.EmailId) is null ? null : "true")" aria-describedby="@(_problems.For(ForgotPasswordModel.EmailId) is null ? null : ForgotPasswordModel.EmailId + "-error")" />
                    <FieldError FieldId="@ForgotPasswordModel.EmailId" Problem="_problems.For(ForgotPasswordModel.EmailId)" />
                </div>
                <div class="form-actions"><button class="btn btn--primary" type="submit">@Pl.Forgot.Submit</button></div>
            </EditForm>
        }
        <p><a href="@ReturnTarget.LoginPath">@Pl.Forgot.BackToLogin</a></p>
    </div>
</div>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] ForgotPasswordModel? Model { get; set; }

    FormProblems _problems = new();
    string? _message;
    bool _sent, _oauthOnly;

    protected override void OnInitialized() => Model ??= new();

    async Task SubmitAsync()
    {
        _problems = Model!.Validate();
        if (_problems.Any) return;
        var result = await Identity.ForgotPasswordAsync(Model.Email!.Trim(), HttpContext.RequestAborted);
        switch (result.Outcome)
        {
            case ForgotOutcome.Sent: _sent = true; _oauthOnly = result.IsOAuthOnly; return;
            case ForgotOutcome.InvalidEmail: _problems.Add(ForgotPasswordModel.EmailId, Pl.Register.EmailInvalid); return;
            case ForgotOutcome.RateLimited: _message = Pl.Forgot.RateLimited; return;
            default: _message = Pl.Forgot.Unavailable; return;
        }
    }
}
