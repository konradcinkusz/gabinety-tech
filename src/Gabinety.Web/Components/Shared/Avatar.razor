@* Decorative: the name is the text of the link beside it, so the initials are hidden from assistive technology. The colour is chosen from the name, always the same for the same name. *@
@* With a Slug the picture (the verified GitHub avatar, ADR-0013) is laid OVER the initials: when /avatar/{slug} answers 404 the browser shows no image and the initials stay visible (no script). *@
<span class="avatar avatar--@Size.ToString().ToLowerInvariant() avatar--@Tone(Name)" aria-hidden="true">@Letters(Name)@if (!string.IsNullOrEmpty(Slug)){<img class="avatar__image" src="@($"/avatar/{Uri.EscapeDataString(Slug)}")" alt="" width="@Pixels" height="@Pixels" loading="lazy" />}</span>

@code {
    public enum AvatarSize { Small, Medium, Large }

    static readonly string[] Tones = ["accent", "success", "warning", "danger", "neutral"];

    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Medium;

    /// <summary>The slug of a practitioner whose GitHub account is verified; leave empty when there is no <c>githubLogin</c>, so no image is requested.</summary>
    [Parameter] public string? Slug { get; set; }

    int Pixels => Size switch { AvatarSize.Small => 36, AvatarSize.Large => 72, _ => 48 };

    /// <summary>The first letters of the first two words, uppercase: <c>Anna Demowska</c> is <c>AD</c>, <c>Jan</c> is <c>J</c>.</summary>
    public static string Letters(string name)
    {
        var letters = name.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.FirstOrDefault(char.IsLetterOrDigit))
            .Where(c => c != default)
            .Take(2)
            .Select(char.ToUpperInvariant)
            .ToArray();
        return letters.Length == 0 ? "?" : new string(letters);
    }

    /// <summary>One of the five tones, from a hash that does not change between processes (string hashing is randomised per run, so it is not used).</summary>
    public static string Tone(string name) => Tones[Fnv1a(name) % (uint)Tones.Length];

    static uint Fnv1a(string text)
    {
        var hash = 2166136261u;
        foreach (var c in text)
        {
            hash ^= c;
            hash *= 16777619u;
        }
        return hash;
    }
}
