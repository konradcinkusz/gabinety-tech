@* The callout of DESIGN-CONTRACT 5.5: role="alert", the heading "Popraw N pól", one link per problem to its field. It takes the focus when the page loads (autofocus works on any element), so a submit with errors starts reading here. *@
@if (Problems.Any)
{
    <div class="callout callout--danger form-summary" role="alert" tabindex="-1" autofocus data-testid="form-summary">
        <h2>@Problems.Heading</h2>
        <ul>
            @foreach (var p in Problems.Items)
            {
                <li><a href="#@p.FieldId">@p.Message</a></li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public FormProblems Problems { get; set; } = new();
}
