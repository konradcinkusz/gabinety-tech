    <ProjectReference Include="../../src/Gabinety.Billing/Gabinety.Billing.csproj" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/RouteAuth.cs" Link="RouteAuth.cs" /></ItemGroup>
</Project>
