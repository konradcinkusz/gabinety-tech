@* Errors are state, not exceptions (BLAZOR-WEB-APP section 5): a failing region renders one of these and the rest of the page still renders. Danger announces itself (role="alert"); the others are polite status text. *@
<div class="@CssClass" role="@(Variant == AlertVariant.Danger ? "alert" : "status")" data-testid="@TestId">@ChildContent</div>

@code {
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Danger;
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CssClass => $"callout callout--{Variant.ToString().ToLowerInvariant()}";
}
