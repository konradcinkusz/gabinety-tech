@inject TimeProvider Time
<article class="card practitioner-card" data-testid="practitioner-card">
    <h2 class="practitioner-card__name"><a href="@($"/gabinet/{Practitioner.Slug}")">@Practitioner.DisplayName</a></h2>
    <p class="practitioner-card__headline">@Practitioner.Headline</p>
    <ul class="cluster">
        @* One badge: the four checks are the same on every card and so carry no information; the full list is on the profile (P-LIST-2). *@
        @if (Practitioner.Badges.Contains("approved"))
        {
            <li><span class="badge badge--success">@PlPages.ListExtra.Verified</span></li>
        }
        @if (Practitioner.Contract is { } contract)
        {
            <li><span class="badge badge--info" data-testid="card-contract">@ContractAvailabilityFormat.CardLine(contract, PlFormat.TodayWarsaw(Time.GetUtcNow()))</span></li>
        }
        <li>
            @if (Practitioner.Rating is { } rating && !Practitioner.IsNew)
            {
                <span class="badge" aria-label="@string.Format(Pl.Card.Rating, PlFormat.Rating(rating.Average), rating.Count)">★ @PlFormat.Rating(rating.Average) (@rating.Count)</span>
            }
            else
            {
                <span class="badge">@Pl.Card.IsNew</span>
            }
        </li>
    </ul>
    <p class="cluster">
        <span>@Pl.Card.From <span class="num">@Money.Pln(Practitioner.FromPrice.AmountMinor)</span></span>
        <span>@string.Join(", ", Practitioner.Durations.Select(d => string.Format(Pl.Filters.Minutes, d)))</span>
    </p>
</article>

@code {
    static readonly System.Globalization.CultureInfo Invariant = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired] public PractitionerCardDto Practitioner { get; set; } = default!;

    static string BadgeLabel(string badge) => badge switch
    {
        "email" => Pl.Card.BadgeEmail,
        "github" => Pl.Card.BadgeGithub,
        "nip" => Pl.Card.BadgeNip,
        "approved" => Pl.Card.BadgeApproved,
        _ => badge,
    };
}
