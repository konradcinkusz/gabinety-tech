@* A state as a badge: the label is always text (colour never carries the meaning alone, contract 5.7); the kind is neutral, info, success, warning or danger. *@
<span class="@($"badge badge--{Kind}")" data-testid="@TestId">@Label</span>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Kind { get; set; } = "neutral";
    [Parameter] public string? TestId { get; set; }
}
