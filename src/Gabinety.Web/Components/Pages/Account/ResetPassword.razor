@page "/reset-password"
@attribute [AllowAnonymous]
@using Gabinety.Web.Components.Layout
@using Gabinety.Web.Hosting
@inject IdentityClient Identity
@inject NavigationManager Navigation
@* Static server rendering. The link authservice mails carries ?token=&email=: both are read from the query ONCE (first display) and kept in hidden fields; the form posts to the bare path, so the next
   request has no token in its URL. Neither is rendered as text or into a link, neither is logged. Sets no session: the person signs in afterwards. The page is noindex and asks browsers to send only the origin as referrer, never the token-bearing path (not "no-referrer": that makes a browser send `Origin: null` on the form post, which the origin guard refuses with 403, so no one could reset; found by J9)
   (a meta tag: the host's security-header middleware writes the Referrer-Policy header last, for every route, and would overwrite a header set here). *@

<PageTitle>@Pl.Reset.MetaTitle</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="strict-origin" />
</HeadContent>

<div class="container--form auth-page">
    <div class="card">
        <h1>@Pl.Reset.Title</h1>

        @if (_badToken)
        {
            <Alert Variant="AlertVariant.Danger" TestId="reset-bad-token">@Pl.Reset.BadToken</Alert>
            <p><a class="btn btn--primary" href="/zapomniane-haslo">@Pl.Reset.RequestNew</a></p>
        }
        else
        {
            <FormSummary Problems="_problems" />
            <div role="alert">
                @if (_message is not null)
                {
                    <p class="callout callout--danger" data-testid="reset-error">@_message</p>
                }
            </div>
            <EditForm Model="Model!" FormName="reset-password" OnSubmit="SubmitAsync" action="/reset-password" class="form" novalidate>
                <input type="hidden" name="Model.Token" value="@Model!.Token" />
                <input type="hidden" name="Model.Email" value="@Model!.Email" />
                <div class="field @Invalid(ResetPasswordModel.PasswordId)">
                    <label class="field__label" for="@ResetPasswordModel.PasswordId">@Pl.Reset.Password</label>
                    <ul class="field__hint password-rules" id="@RulesId">
                        <li>@Pl.Register.RuleLength</li>
                        <li>@Pl.Register.RuleCase</li>
                        <li>@Pl.Register.RuleDigit</li>
                        <li>@Pl.Register.RuleSymbol</li>
                    </ul>
                    <div class="auth-password">
                        <input id="@ResetPasswordModel.PasswordId" name="Model.Password" class="field__control" type="password" autocomplete="new-password"
                               aria-invalid="@AriaInvalid(ResetPasswordModel.PasswordId)" aria-describedby="@Describe(ResetPasswordModel.PasswordId, RulesId)" />
                        @* Progressive enhancement: hidden here, shown by the script that adds the reveal. Without script the password is simply typed as it is. *@
                        <button type="button" class="btn btn--ghost" data-enhance="reveal" data-target="#@(ResetPasswordModel.PasswordId)" hidden>@Pl.Reset.ShowPassword</button>
                    </div>
                    <FieldError FieldId="@ResetPasswordModel.PasswordId" Problem="_problems.For(ResetPasswordModel.PasswordId)" />
                </div>
                <div class="field @Invalid(ResetPasswordModel.ConfirmationId)">
                    <label class="field__label" for="@ResetPasswordModel.ConfirmationId">@Pl.Reset.Confirmation</label>
                    <div class="auth-password">
                        <input id="@ResetPasswordModel.ConfirmationId" name="Model.Confirmation" class="field__control" type="password" autocomplete="new-password"
                               aria-invalid="@AriaInvalid(ResetPasswordModel.ConfirmationId)" aria-describedby="@Describe(ResetPasswordModel.ConfirmationId)" />
                        <button type="button" class="btn btn--ghost" data-enhance="reveal" data-target="#@(ResetPasswordModel.ConfirmationId)" hidden>@Pl.Reset.ShowPassword</button>
                    </div>
                    <FieldError FieldId="@ResetPasswordModel.ConfirmationId" Problem="_problems.For(ResetPasswordModel.ConfirmationId)" />
                </div>
                <div class="form-actions"><button class="btn btn--primary" type="submit">@Pl.Reset.Submit</button></div>
            </EditForm>
        }
    </div>
</div>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;

    /// <summary>Read once, on the first display, into the hidden fields. A post carries them in its form and never in its URL.</summary>
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }

    [SupplyParameterFromForm] ResetPasswordModel? Model { get; set; }

    const string RulesId = "reset-password-rules";

    FormProblems _problems = new();
    string? _message;
    bool _badToken;

    protected override void OnInitialized()
    {
        Model ??= new ResetPasswordModel { Token = Token, Email = Email };
        _badToken = Model.LinkIsIncomplete;
    }

    async Task SubmitAsync()
    {
        _problems = Model!.Validate();
        if (_problems.Any) return;
        var outcome = await Identity.ResetPasswordAsync(Model.Email!.Trim(), Model.Token!, Model.Password!, HttpContext.RequestAborted);
        switch (outcome)
        {
            case ResetOutcome.Done: Navigation.NavigateTo($"{ReturnTarget.LoginPath}?{FlashKey.Parameter}={FlashKey.PasswordReset}"); return;
            case ResetOutcome.InvalidToken: _badToken = true; return;
            case ResetOutcome.PasswordRejected: _problems.Add(ResetPasswordModel.PasswordId, Pl.Reset.PasswordRejected); return;
            case ResetOutcome.RateLimited: _message = Pl.Reset.RateLimited; return;
            default: _message = Pl.Reset.Unavailable; return;
        }
    }

    string Invalid(string id) => _problems.For(id) is null ? "" : "field--invalid";
    string? AriaInvalid(string id) => _problems.For(id) is null ? null : "true";
    string? Describe(string id, string? hintId = null) => string.Join(' ', new[] { hintId, _problems.For(id) is null ? null : id + "-error" }.Where(x => x is not null)) is { Length: > 0 } d ? d : null;
}
